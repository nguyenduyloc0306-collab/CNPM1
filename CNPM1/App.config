<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<!-- Sửa Data Source cho đúng tên SQL Server của bạn: ., .\SQLEXPRESS, (localdb)\MSSQLLocalDB ... -->
		<add name="QLCuaHang"
             connectionString="Data Source=tcp:127.0.0.1,1433;Initial Catalog=CNPM;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>